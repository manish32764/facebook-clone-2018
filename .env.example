# Copy to .env to override any of these. docker compose reads .env automatically.

# --- database ---
POSTGRES_DB=facebookclone
POSTGRES_USER=fbclone
POSTGRES_PASSWORD=fbclone
DB_PORT=5432

# --- application ---
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Must be at least 32 characters. Change this outside of local development.
APP_JWT_SECRET=change-me-in-production-facebook-clone-2018-demo-secret-key
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost
